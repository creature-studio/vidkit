{
  "name": "vidkit",
  "version": "0.2.0",
  "description": "Deterministic HTML/JS → MP4 video framework: render(t) core, effect presets, scene authoring API, CLI.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "browser": "dist/vidkit.js",
  "bin": { "vk": "bin/vk.mjs" },
  "vidkit": { "global": "vk", "bundle": "dist/vidkit.js" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "examples": "node scripts/render-examples.mjs",
    "docs": "node scripts/docs.mjs"
  },
  "files": ["src", "dist", "bin", "cli", "fonts", "styles", "tools", "vendor", "README.md"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": { "playwright": "1.63.0" },
  "devDependencies": { "esbuild": "^0.28.2" }
}
